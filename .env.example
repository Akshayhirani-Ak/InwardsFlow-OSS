# InwardsFlow — environment variables (copy to .env.local for local dev;
# set the same names in Vercel → Project Settings → Environment Variables).
# NEVER commit a real .env file. No value has a code fallback: if a variable
# is missing, the app fails loudly instead of using someone else's project.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — safe for the browser ONLY because RLS is enforced
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only: service-role key. Bypasses RLS. NEVER expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=...

# Server-only: Google Gemini API key, restricted to the Generative Language API.
# Sent in the x-goog-api-key header by server routes only.
GEMINI_API_KEY=...

# Optional: pinned Gemini model override (must be on the server allowlist)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional (Phase 4): Upstash Redis REST — shared rate limiting for
# /api/ai-intake. Without it, the route falls back to a per-instance
# in-memory limiter.
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...

# Phase 10 (added when it lands):
# NEXT_PUBLIC_SENTRY_DSN=...
